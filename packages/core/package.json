{
  "name": "@crosskit-ui/core",
  "version": "2.0.0",
  "description": "Framework-agnostic core for CrossKit: design tokens types, icon data, theme controller and shared behaviour.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saeedkolivand/crosskit.git",
    "directory": "packages/core"
  },
  "homepage": "https://crosskit.iamsaeed.dev/",
  "bugs": {
    "url": "https://github.com/saeedkolivand/crosskit/issues"
  },
  "author": "Saeed Kolivand",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "check:exports": "publint --strict && attw --pack --profile esm-only"
  },
  "dependencies": {
    "@tanstack/table-core": "catalog:table",
    "@zag-js/toast": "catalog:zag"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "jsdom": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
