{
  "name": "@crosskit-ui/svelte",
  "version": "1.0.0",
  "description": "CrossKit components for Svelte 5.",
  "type": "module",
  "sideEffects": false,
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saeedkolivand/crosskit.git",
    "directory": "packages/svelte"
  },
  "homepage": "https://crosskit.iamsaeed.dev/",
  "bugs": {
    "url": "https://github.com/saeedkolivand/crosskit/issues"
  },
  "author": "Saeed Kolivand",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint src",
    "check:exports": "publint --strict"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "@crosskit-ui/core": "workspace:^",
    "@crosskit-ui/styles": "workspace:^",
    "@zag-js/accordion": "catalog:zag",
    "@zag-js/dialog": "catalog:zag",
    "@zag-js/presence": "catalog:zag",
    "@zag-js/menu": "catalog:zag",
    "@zag-js/tooltip": "catalog:zag",
    "@zag-js/select": "catalog:zag",
    "@zag-js/svelte": "catalog:zag",
    "@zag-js/tabs": "catalog:zag",
    "@zag-js/toast": "catalog:zag"
  },
  "devDependencies": {
    "@sveltejs/package": "catalog:frameworks",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "publint": "catalog:",
    "svelte": "catalog:frameworks",
    "svelte-check": "^4.7.5",
    "typescript": "catalog:"
  }
}
