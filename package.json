{
  "name": "crosskit",
  "private": true,
  "type": "module",
  "description": "Framework-agnostic UI components. One behavior core, one stylesheet, adapters for React, Vue, Svelte and Angular.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saeedkolivand/crosskit.git"
  },
  "homepage": "https://crosskit.iamsaeed.dev/",
  "bugs": {
    "url": "https://github.com/saeedkolivand/crosskit/issues"
  },
  "author": "Saeed Kolivand",
  "license": "MIT",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "check:exports": "turbo run check:exports",
    "format": "prettier --write \"{packages,apps}/**/*.{ts,tsx,vue,svelte,css,md,json}\"",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "turbo run build && changeset publish",
    "prepare": "husky",
    "gen:readmes": "node scripts/gen-package-readmes.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint-react/eslint-plugin": "^5.18.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "catalog:",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "rimraf": "^6.1.3",
    "turbo": "^2.10.8",
    "typescript": "catalog:",
    "typescript-eslint": "^8.65.0",
    "vitest": "catalog:"
  },
  "lint-staged": {
    "{packages,apps}/**/*.{ts,tsx,vue,svelte}": [
      "eslint --fix",
      "prettier --write"
    ],
    "{packages,apps}/**/*.{css,md,json,yml}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "ui",
    "components",
    "design-system",
    "typescript",
    "tailwind",
    "react",
    "vue",
    "svelte",
    "angular",
    "framework-agnostic",
    "headless"
  ]
}
